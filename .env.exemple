# Copier vers .env et renseigner si vous avez une cle.
# Ne jamais committer .env.

# ---------------------------------------------------------------------------
# API-Football (api-sports.io) — optionnel
# ---------------------------------------------------------------------------
# Sans cle : le collecteur affiche « API-Football ignoree (pas de cle) » et continue.
# Avec cle : fixtures/scores recents (Big 5 + Super Lig + LDC si quota) puis
#            stats joueurs defensives (une ligue a la fois). Free tier ~100 req/jour.
#
# Obtenir la cle :
# 1. Compte gratuit : https://dashboard.api-football.com/register
# 2. Dashboard → Account / API → copier la « API Key » (x-apisports-key)
# 3. Coller ci-dessous (sans guillemets). Relancer :
#      python scripts/collecter_api_football.py
#    ou la maj complete :
#      python scripts/mettre_a_jour.py
#
# Limites free : ~100 req/jour, rotation 1–2 ligues/jour + cache disque
# (donnees/cache_api_football/). Free = saisons historiques (souvent 2022–2024) ;
# la saison courante (fixtures live) demande en general un plan Pro.
# Pas de live minute-par-minute sur ce projet.
CLE_API_FOOTBALL=

# The Odds API (the-odds-api.com). Sans cle, la page Cotes affiche le calendrier sans cotes.
CLE_API_COTES=

# Valeurs de marche : pas de cle. Dump tiers CC0 (transfermarkt-datasets /
# Kaggle davidcariboo/player-scores) via scripts/collecter_valeurs_marche.py.
# Zone grise (donnees issues de Transfermarkt) ; jamais de scrape live.

# Compte admin communaute (commentaires + file de moderation).
# Optionnel : l'inscription avec cet e-mail devient admin.
EMAIL_ADMIN_COMMUNAUTE=

# ---------------------------------------------------------------------------
# Deploiement (serveur maison / production)
# ---------------------------------------------------------------------------
# ENVIRONNEMENT=production active le cookie Secure si COOKIE_SECURE n'est pas fixe.
# En local (HTTP) : laisser vide ou development, et COOKIE_SECURE=0 / absent.
ENVIRONNEMENT=

# Cookie session HTTPS uniquement (1/true/oui). Obligatoire derriere Nginx HTTPS.
# En local HTTP : 0 ou absent (sinon le navigateur ignore le cookie).
COOKIE_SECURE=0

# Origines CORS autorisees, separees par des virgules (credentials = cookies).
# Defaut si vide : http://localhost:5173,http://127.0.0.1:5173
# Derriere Nginx (meme origine front+API) : souvent inutile, mais utile si le
# front Vite reste separe : https://statsfoot.votredomaine.fr
ORIGINES_CORS=

# ---------------------------------------------------------------------------
# Connexion Google (OAuth 2.0 / GIS — bouton « Se connecter avec Google »)
# ---------------------------------------------------------------------------
# Sans GOOGLE_CLIENT_ID : seul e-mail/mot de passe est actif.
# Avec une cle valide : l'UI affiche le bouton Google (PageAuthAnimee).
#
# Mise en place (production) :
# 1. Google Cloud Console → APIs & Services → Identifiants
# 2. Creer un ID client OAuth « Application Web »
# 3. Origines JavaScript autorisees : URL exacte du site (ex. https://votredomaine.fr)
#    En local : http://localhost:5173 et http://127.0.0.1:5173
# 4. Copier l'ID client (….apps.googleusercontent.com) dans GOOGLE_CLIENT_ID ci-dessous
# 5. Redemarrer l'API ; GET /api/communaute/config doit renvoyer oauth_google_actif: true
#
# Ne jamais inventer ni committer un vrai client id. Ne pas mettre de secret client :
# le flux utilise un id_token verifie cote serveur (aud = GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Analyse IA (Phase 3 — optionnel)
# ---------------------------------------------------------------------------
# Sans CLE_LLM : le site utilise un récit template (aucune API externe).
# OpenAI-compatible (défaut) :
#   FOURNISSEUR_LLM=openai
#   CLE_LLM=sk-...
#   MODELE_LLM=gpt-4o-mini
# Ollama local :
#   FOURNISSEUR_LLM=ollama
#   MODELE_LLM=llama3.2
#   URL_BASE_LLM=http://127.0.0.1:11434/v1/chat/completions
CLE_LLM=
MODELE_LLM=gpt-4o-mini
FOURNISSEUR_LLM=openai
URL_BASE_LLM=
