# Exemple Nginx — copier vers /etc/nginx/sites-available/statsfoot
# puis : sudo ln -s /etc/nginx/sites-available/statsfoot /etc/nginx/sites-enabled/
#
# Remplacer :
#   statsfoot.example.com  → votre domaine
#   /opt/statsfoot         → chemin du dépôt cloné

# Redirection HTTP → HTTPS (activer après certbot)
server {
    listen 80;
    listen [::]:80;
    server_name statsfoot.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name statsfoot.example.com;

    # Certificats Let's Encrypt (certbot les remplit)
    ssl_certificate     /etc/letsencrypt/live/statsfoot.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/statsfoot.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /opt/statsfoot/site/frontend/dist;
    index index.html;

    # Fichiers statiques du build Vue (cache long pour assets hashés)
    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # API FastAPI (uvicorn en local)
    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Photos joueurs (StaticFiles FastAPI)
    location /photos/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 7d;
    }

    # SPA Vue — routes client-side
    location / {
        try_files $uri $uri/ /index.html;
    }

    # En-têtes de sécurité de base
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
