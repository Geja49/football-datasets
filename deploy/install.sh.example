#!/usr/bin/env bash
# Script d'installation commenté — NE PAS exécuter tel quel sans lire chaque étape.
# Usage prévu : copier les sections une par une, adapter les variables, puis lancer.
#
# Prérequis : Ubuntu 22.04+ / Debian 12+, accès root (sudo).
# Serveur maison : domaine + ports 80/443, ou Cloudflare Tunnel / Tailscale (voir README-DEPLOIEMENT.md).
# Prérequis VPS classiques : domaine pointant vers le serveur.

set -euo pipefail

# --- Variables à personnaliser ---
DOMAINE="statsfoot.example.com"
REPO_URL="https://github.com/VOTRE_ORG/football-datasets.git"
CHEMIN="/opt/statsfoot"
UTILISATEUR="statsfoot"

